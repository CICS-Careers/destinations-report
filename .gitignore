.idea/
.DS_Store
AWSCLIV2.pkg

# Sensitive source workbooks and review artifacts stay local. Do not force-add
# these files: they can contain student-level outcomes and identifiers.
private/
*.xlsx
*.xlsm
*.xls
*.xlsb
*.ods
*.numbers

# Outputs of the data-preparation scripts belong in private/releases/, never in
# Git. Only the empty review templates under templates/ are tracked. To publish
# an approved aggregate file, add an explicit exception here in a reviewed PR.
data/
*.csv
*.tsv
!templates/*.csv
*.parquet
*.feather
*.sqlite
*.db
reconciliation_summary.json
release_manifest.json

# Local site build output.
_site/
